# Biến môi trường mẫu — Copy thành .env và điền giá trị thực

# =====================
# PostgreSQL
# =====================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# =====================
# MinIO S3 Object Storage
# =====================
MINIO_ENDPOINT="YOUR_VPS_IP"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="YOUR_ACCESS_KEY"
MINIO_SECRET_KEY="YOUR_SECRET_KEY"
MINIO_BUCKET="websitecar"
MINIO_PUBLIC_URL="http://YOUR_VPS_IP:9000/websitecar"

# =====================
# JWT Authentication
# =====================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# =====================
# Admin Account (dùng cho seed ban đầu)
# =====================
ADMIN_EMAIL="admin@vinfast.vn"
ADMIN_PASSWORD="Admin@123456"

# =====================
# App Config
# =====================
NEXT_PUBLIC_API_URL="http://YOUR_VPS_IP:4000"
PORT="4000"
